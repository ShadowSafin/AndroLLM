# ===========================================================================
# AndroLLM - comprehensive .gitignore
# ===========================================================================

# ---------------------------------------------------------------------------
# Gradle / Android build outputs
# ---------------------------------------------------------------------------
.gradle/
build/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.war
*.ear
*.m4a
*.mtl
*.idsig

# Keep the Gradle wrapper jar tracked (required to build)
!gradle/wrapper/gradle-wrapper.jar

# Android Studio generated native build dirs (per module)
.cxx/
.externalNativeBuild/
CMakeUserPresets.json

# Android test/report output
reports/
outputs/
.android/
.native-session.json

# ---------------------------------------------------------------------------
# Local / machine-specific configuration (never commit)
# ---------------------------------------------------------------------------
local.properties
*.properties.orig
keystore.properties
gradle.properties.bak

# ---------------------------------------------------------------------------
# Native / C / C++ build artifacts
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.dSYM/
*.lib
*.exe
*.out
*.pyc
*.pyo

# Vendored llama.cpp standalone build output
engine/src/main/cpp/llama.cpp/build/

# ---------------------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
.vscode/
*.swp
*.swo
*~
.ntfs_metadata

# Kotlin / IntelliJ project caches
.kotlin/
.harness/

# Claude AI
.claude/

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.lnk

# ---------------------------------------------------------------------------
# Logs, local helper scripts, temp files
# ---------------------------------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log
*.stackdump
*.trace
*.dump
logs/
tmp/
temp/
*.tmp
_gradle_out.txt
_run_gradle.bat
_build_out.txt
_build_out_*.txt
androllm_*.txt

# ---------------------------------------------------------------------------
# Secrets / credentials (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
*.secret
*.secrets
*.credentials
*credentials*.json
*.pem
*.key
*.p12
*.jks
*.keystore
Mainkeystore
secrets/
credentials/
androllm-release.jks

# Firebase config (contains project/client configuration; keep local unless
# the repository intentionally tracks a reviewed configuration file)
**/google-services.json

# Release signing config (user-specific passwords)
signing.properties
release-signing.properties

# ---------------------------------------------------------------------------
# Release / signed APKs (never commit)
# ---------------------------------------------------------------------------
app/release/
release/
app-release-signed.apk

# ---------------------------------------------------------------------------
# Runtime artifacts / model weights / memory dumps
# ---------------------------------------------------------------------------
*.hprof
*.jfr
*.heapsnapshot
*.gguf
*.safetensors
*.ckpt
*.onnx
*.tflite
.venv/
venv/

# ---------------------------------------------------------------------------
# Test / coverage output
# ---------------------------------------------------------------------------
.coverage/
coverage/
*.ec
*.exec
*.lcov

# Local scratch / tooling
.impeccable/
META-INF/
skills-lock.json
scratch/

# Agent skills (never commit)
.agents/

# Bundled voice models (sherpa-onnx) — downloaded by downloadVoiceModels
app/src/main/assets/voice/

# Oryon-SoC workaround binaries — REQUIRED for wake-word/ASR on Snapdragon
# 8 Elite / 8s Gen 4 (k2-fsa/sherpa-onnx#3845). Overrides the AAR's
# libonnxruntime.so with 1.28.0 + version-patched sherpa libs; see
# tools/patch_ver.py and the jniLibs comment in app/build.gradle.kts.
!app/src/main/jniLibs/
!app/src/main/jniLibs/**

# ---------------------------------------------------------------------------
# Qualcomm QNN runtime libraries (imagegen) — SDK artifacts, never commit.
#
# imagegen/src/main/jniLibs/arm64-v8a/libQnn*.so (and libcdsprpc.so when
# provided) are copied from the local Qualcomm AI Engine Direct / QAIRT SDK
# (see imagegen/build.gradle.kts:syncQnnRuntimeLibs and
# documentation/qnn-npu.md). The global *.so rule above already ignores them;
# this section exists to document WHY. Refresh with:
#   set QAIRT_ROOT=C:\Qualcomm\AIStack\QAIRT
#   ./gradlew :imagegen:syncQnnRuntimeLibs

