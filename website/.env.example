# Copy to .env.local for local dev. Never commit .env.local (gitignored).
# Firebase web config is PUBLIC by design (same project as the Android app).
# Get values from: Firebase Console → Project Settings → Your Apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=androllm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=androllm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=androllm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Private backend base URL (no trailing slash). Empty = backend disabled.
# Examples: http://localhost:8080 (local) or https://api.androllm.app (prod).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
