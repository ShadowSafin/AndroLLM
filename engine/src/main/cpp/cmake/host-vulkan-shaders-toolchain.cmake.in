# Host-only toolchain for llama.cpp's Vulkan shader generator.
set(CMAKE_C_COMPILER "@ANDROLLM_HOST_C_COMPILER@")
set(CMAKE_CXX_COMPILER "@ANDROLLM_HOST_CXX_COMPILER@")
set(CMAKE_MAKE_PROGRAM "@ANDROLLM_HOST_NINJA@" CACHE FILEPATH
    "Host Ninja used by the Vulkan shader generator" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
